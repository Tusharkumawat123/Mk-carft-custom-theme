<section
  class="mk-collections"
  data-mk-collections
  style="
    --mk-col-pt: {{ section.settings.padding_top }}px;
    --mk-col-pb: {{ section.settings.padding_bottom }}px;
  "
>

  <div class="mk-collections__inner">

    <div class="mk-collections__heading">

      <div>
        <span class="mk-collections__eyebrow">
          Explore our craft
        </span>

        <h2>{{ section.settings.heading }}</h2>
      </div>

      {% if section.settings.button_label != blank %}
        <a href="{{ section.settings.button_link }}">
          {{ section.settings.button_label }}
        </a>
      {% endif %}

    </div>

    <div class="mk-collections__list">

      {% for block in section.blocks %}

        {% assign collection = block.settings.collection %}

        <a
          href="{% if collection != blank %}{{ collection.url }}{% else %}#{% endif %}"
          class="mk-collection-card"
          {{ block.shopify_attributes }}
        >

          <div class="mk-collection-card__image">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900',
                  class: 'mk-collection-card__img'
              }}

            {% elsif collection.featured_image != blank %}

              {{
                collection.featured_image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 900',
                  class: 'mk-collection-card__img'
              }}

            {% endif %}

            <div class="mk-collection-card__overlay"></div>

            <div class="mk-collection-card__content">

              <span>
                {{ block.settings.small_text }}
              </span>

              <strong>
                {% if block.settings.title != blank %}
                  {{ block.settings.title }}
                {% elsif collection != blank %}
                  {{ collection.title }}
                {% endif %}
              </strong>

              <em>
                Explore collection →
              </em>

            </div>

          </div>

        </a>

      {% endfor %}

    </div>

  </div>

</section>

<style>

  .mk-collections {
    padding-top: var(--mk-col-pt);
    padding-bottom: var(--mk-col-pb);
    background: #faf7f2;
  }

  .mk-collections__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .mk-collections__heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    margin-bottom: 35px;
  }

  .mk-collections__eyebrow {
    display: block;
    margin-bottom: 10px;
    color: #966642;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 700;
  }

  .mk-collections__heading h2 {
    margin: 0;
    color: #3c2a20;
    font-size: clamp(30px, 4vw, 50px);
    line-height: 1.05;
    font-weight: 500;
  }

  .mk-collections__heading > a {
    color: #4b3223;
    text-decoration: none;
    border-bottom: 1px solid #4b3223;
    padding-bottom: 4px;
    font-size: 13px;
  }

  .mk-collections__list {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  .mk-collection-card {
    flex: 1 1 calc(33.333% - 12px);
    min-width: 280px;
    text-decoration: none;
    overflow: hidden;
  }

  .mk-collection-card__image {
    position: relative;
    overflow: hidden;
    aspect-ratio: .85;
    background: #e9dfd4;
  }

  .mk-collection-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .8s cubic-bezier(.2,.7,.2,1);
  }

  .mk-collection-card:hover .mk-collection-card__img {
    transform: scale(1.07);
  }

  .mk-collection-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(35,22,14,.78),
      rgba(35,22,14,.05) 65%
    );
  }

  .mk-collection-card__content {
    position: absolute;
    left: 25px;
    right: 25px;
    bottom: 25px;
    color: #fff;
    transform: translateY(8px);
    transition: transform .4s ease;
  }

  .mk-collection-card:hover .mk-collection-card__content {
    transform: translateY(0);
  }

  .mk-collection-card__content span {
    display: block;
    margin-bottom: 5px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    opacity: .8;
  }

  .mk-collection-card__content strong {
    display: block;
    font-size: 25px;
    font-weight: 500;
  }

  .mk-collection-card__content em {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    font-style: normal;
    opacity: 0;
    transform: translateY(8px);
    transition: all .35s ease;
  }

  .mk-collection-card:hover .mk-collection-card__content em {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 749px) {

    .mk-collections__inner {
      padding: 0 20px;
    }

    .mk-collections__heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 15px;
    }

    .mk-collection-card {
      flex: 1 1 100%;
      min-width: 0;
    }

    .mk-collection-card__image {
      aspect-ratio: 1 / .95;
    }

  }

</style>

<script>
(function () {

  function initMKCollections() {

    document.querySelectorAll('[data-mk-collections]').forEach(function (section) {

      if (section.dataset.initialized === 'true') return;

      section.dataset.initialized = 'true';

      if (!('IntersectionObserver' in window)) {
        section.classList.add('is-visible');
        return;
      }

      var observer = new IntersectionObserver(function (entries) {

        entries.forEach(function (entry) {

          if (entry.isIntersecting) {

            entry.target.classList.add('is-visible');

            observer.unobserve(entry.target);

          }

        });

      }, {
        threshold: .1
      });

      observer.observe(section);

    });

  }

  document.addEventListener('DOMContentLoaded', initMKCollections);

  document.addEventListener(
    'shopify:section:load',
    initMKCollections
  );

})();
</script>

{% schema %}
{
  "name": "MK Collections",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "small_text",
          "label": "Small text",
          "default": "Handcrafted"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Wooden Sculptures"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find something made for your space"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "View all collections"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 90
    }
  ],
  "presets": [
    {
      "name": "MK Collections",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}