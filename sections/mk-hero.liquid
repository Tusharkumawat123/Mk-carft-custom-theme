<section
  class="mk-hero"
  data-mk-hero
  style="
    --mk-hero-pt: {{ section.settings.padding_top }}px;
    --mk-hero-pb: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="mk-hero__inner">

    <div class="mk-hero__content">

      {% if section.settings.eyebrow != blank %}
        <span class="mk-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="mk-hero__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="mk-hero__text">
          {{ section.settings.text }}
        </div>
      {% endif %}

      <div class="mk-hero__buttons">

        {% if section.settings.button_label != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="mk-hero__button mk-hero__button--primary"
          >
            {{ section.settings.button_label }}
          </a>
        {% endif %}

        {% if section.settings.secondary_label != blank %}
          <a
            href="{{ section.settings.secondary_link }}"
            class="mk-hero__button mk-hero__button--secondary"
          >
            {{ section.settings.secondary_label }}
          </a>
        {% endif %}

      </div>

    </div>

    <div class="mk-hero__visual">

      {% if section.settings.hero_image != blank %}
        <div class="mk-hero__image-wrap">
          {{
            section.settings.hero_image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '600, 900, 1200, 1600',
              sizes: '(max-width: 749px) 100vw, 55vw',
              class: 'mk-hero__image'
          }}
        </div>
      {% endif %}

      <div class="mk-hero__wood-card">
        <span>HANDCRAFTED</span>
        <strong>With Natural Wood</strong>
      </div>

    </div>

  </div>
</section>

<style>
  .mk-hero {
    padding-top: var(--mk-hero-pt);
    padding-bottom: var(--mk-hero-pb);
    background: #f5efe7;
    overflow: hidden;
  }

  .mk-hero__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 70px;
  }

  .mk-hero__content {
    flex: 1 1 45%;
    opacity: 0;
    transform: translateY(35px);
    transition: opacity .8s ease, transform .8s ease;
  }

  .mk-hero.is-visible .mk-hero__content {
    opacity: 1;
    transform: translateY(0);
  }

  .mk-hero__eyebrow {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 12px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #8a5a35;
    font-weight: 700;
  }

  .mk-hero__heading {
    margin: 0;
    max-width: 650px;
    font-size: clamp(42px, 5vw, 76px);
    line-height: .98;
    letter-spacing: -2px;
    color: #3b281d;
    font-weight: 600;
  }

  .mk-hero__text {
    max-width: 550px;
    margin-top: 25px;
    color: #685548;
    font-size: 17px;
    line-height: 1.7;
  }

  .mk-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 34px;
  }

  .mk-hero__button {
    min-height: 50px;
    padding: 0 27px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    border-radius: 2px;
    font-size: 14px;
    font-weight: 600;
    transition: all .3s ease;
  }

  .mk-hero__button--primary {
    color: #fff;
    background: #563823;
  }

  .mk-hero__button--primary:hover {
    background: #3d2719;
    transform: translateY(-2px);
  }

  .mk-hero__button--secondary {
    color: #563823;
    border: 1px solid #8d6b50;
    background: transparent;
  }

  .mk-hero__button--secondary:hover {
    background: #563823;
    color: #fff;
  }

  .mk-hero__visual {
    position: relative;
    flex: 1 1 55%;
    min-width: 0;
  }

  .mk-hero__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 1 / .9;
  }

  .mk-hero__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 1.5s cubic-bezier(.2,.7,.2,1);
  }

  .mk-hero.is-visible .mk-hero__image {
    transform: scale(1);
  }

  .mk-hero__wood-card {
    position: absolute;
    right: -25px;
    bottom: 30px;
    padding: 18px 25px;
    background: #fff;
    box-shadow: 0 15px 40px rgba(53,35,22,.15);
  }

  .mk-hero__wood-card span {
    display: block;
    font-size: 10px;
    letter-spacing: 2px;
    color: #997052;
  }

  .mk-hero__wood-card strong {
    display: block;
    margin-top: 4px;
    color: #3b281d;
    font-size: 14px;
  }

  @media (max-width: 749px) {

    .mk-hero {
      padding-top: calc(var(--mk-hero-pt) * .65);
      padding-bottom: calc(var(--mk-hero-pb) * .65);
    }

    .mk-hero__inner {
      padding: 0 20px;
      flex-direction: column;
      gap: 40px;
      align-items: stretch;
    }

    .mk-hero__heading {
      font-size: clamp(38px, 12vw, 54px);
      letter-spacing: -1.5px;
    }

    .mk-hero__text {
      font-size: 15px;
    }

    .mk-hero__visual {
      width: 100%;
    }

    .mk-hero__wood-card {
      right: 12px;
      bottom: 12px;
    }

  }
</style>

<script>
(function () {

  function initMKHero() {

    document.querySelectorAll('[data-mk-hero]').forEach(function (hero) {

      if (hero.dataset.initialized === 'true') return;

      hero.dataset.initialized = 'true';

      if (!('IntersectionObserver' in window)) {
        hero.classList.add('is-visible');
        return;
      }

      var observer = new IntersectionObserver(function (entries) {

        entries.forEach(function (entry) {

          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);

          }

        });

      }, {
        threshold: 0.15
      });

      observer.observe(hero);

    });

  }

  document.addEventListener('DOMContentLoaded', initMKHero);

  document.addEventListener(
    'shopify:section:load',
    initMKHero
  );

})();
</script>

{% schema %}
{
  "name": "MK Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Handcrafted in India"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Objects with a story, crafted by hand."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover beautifully handcrafted wooden decor made from natural Kadam wood and shaped by skilled artisans.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "Shop Handcrafted"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button",
      "default": "Our Story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "unit": "px",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "MK Hero"
    }
  ]
}
{% endschema %}